# Kopieren nach ".env" und anpassen.

DATABASE_URL=sqlite:///./data/app.db

# Lokale KI-Komponente (OpenAI-kompatible API).
# Produktiv: echter lokaler Inference-Server, z.B. Ollama:
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=gemma3:4b
# Für Entwicklung/Tests ohne echtes Modell (siehe mock_llm_server/):
#   AI_BASE_URL=http://localhost:8100/v1
#   AI_MODEL=mock-model
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=gemma3:4b
AI_API_KEY=not-needed-for-local-inference
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1

FORECAST_HORIZON_HOURS=24
MIN_HISTORY_DAYS_FOR_FORECAST=7

# Optional: echte Preise sammeln statt/zusätzlich zu den synthetischen
# Beispieldaten (siehe README, Abschnitt "Echte Daten sammeln", und
# AI_DEVELOPMENT_LOG.md Episode 9). Leer lassen = deaktiviert.
TANKERKOENIG_API_KEY=
TANKERKOENIG_STATION_UUIDS=
